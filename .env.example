# Copy to .env.local for Next.js. Vercel needs the storefront values below;
# the Express admin on the VPS reads the same variables from its process manager.

# HTTP port for the single-process server on a VPS.
PORT=3000

# Local SQLite file used by tests and single-process demos.
# When set, this wins over TURSO_DATABASE_URL everywhere.
# DB_PATH=data/starfall.sqlite

# libSQL/Turso connection used by the Next.js storefront pages and API routes.
# Use file:... locally or libsql://... for a remote Turso database.
TURSO_DATABASE_URL=file:data/starfall.sqlite
TURSO_AUTH_TOKEN=

# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=0

# Optional: pin the private admin slug on the VPS instead of generating one.
ADMIN_SLUG=

# Full public admin URL used by the Vercel storefront, for example
# https://admin.example.com/ops-f091ba41dc60. Leave empty on the single-process
# VPS so the admin link stays relative.
ADMIN_BASE_URL=

# Optional canonical storefront origin.
SITE_URL=http://localhost:3000
