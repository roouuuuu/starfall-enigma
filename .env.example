# Copy to .env.local for Next.js, and set the same values in Vercel.
# The Express admin reads the process environment directly (shell/systemd/pm2).

# HTTP port for the single-process server on a VPS.
PORT=3000

# Local SQLite file used by tests and single-process demos.
# When set, this wins over TURSO_DATABASE_URL everywhere.
# DB_PATH=data/starfall.sqlite

# libSQL/Turso connection used by the Next.js API routes and, after the admin
# migration, by the Express admin too. Use file:... locally or libsql://... for
# a remote Turso database.
TURSO_DATABASE_URL=file:data/starfall.sqlite
TURSO_AUTH_TOKEN=

# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=0

# Optional: pin the private admin slug instead of generating one.
# Required on Vercel because the storefront has no writable disk for
# data/admin-slug.txt.
ADMIN_SLUG=

# Public site URL and the admin URL shown in the storefront footer.
SITE_URL=http://localhost:3000
ADMIN_BASE_URL=
