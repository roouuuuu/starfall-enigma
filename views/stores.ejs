<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content" class="stores-page">
  <header class="stores-hero">
    <img src="/assets/img/editorial/cathedral-detail.jpg" alt="<%= lang === 'id' ? 'Detail jendela katedral' : 'Cathedral window detail' %>" fetchpriority="high">
    <div class="stores-hero-copy">
      <p class="eyebrow"><%= t('stores.kicker') %> / SE</p>
      <h1><%= t('stores.title') %></h1>
      <p><%= t('stores.intro') %></p>
      <a class="button button--light" href="mailto:<%= brandEmail %>?subject=<%= encodeURIComponent('Private appointment request — Starfall Enigma') %>"><%= t('stores.book') %> <span aria-hidden="true">↗</span></a>
    </div>
    <div class="stores-hero-coordinates" aria-hidden="true"><span>06° 13′ S</span><span>106° 49′ E</span></div>
  </header>

  <section class="stores-list section" aria-labelledby="stores-list-title">
    <div class="section-head">
      <div><p class="eyebrow"><%= t('stores.locationsTitle') %></p><h2 id="stores-list-title"><%= lang === 'id' ? 'Enam ruang privat.' : 'Six private rooms.' %></h2></div>
      <p class="section-intro"><%= lang === 'id' ? 'Direktori fiktif untuk demo. Setiap kunjungan diatur melalui concierge.' : 'A fictional directory for the demo. Every visit is arranged through the concierge.' %></p>
    </div>
    <div class="locations-grid">
      <% t('stores.locations').forEach((location, index) => { %>
        <article class="location-card" data-reveal style="--reveal-delay: <%= index * 45 %>ms">
          <div class="location-card-head">
            <span class="location-index">0<%= index + 1 %></span>
            <span class="location-appointment"><%= t('stores.appointmentOnly') %></span>
          </div>
          <h3><%= location.city %></h3>
          <p class="location-country"><%= location.country %></p>
          <address>
            <span><%= location.address %></span>
            <span><%= location.region %></span>
          </address>
          <dl>
            <div><dt><%= t('stores.hours') %></dt><dd><%= location.hours %></dd></div>
            <div><dt><%= t('stores.phone') %></dt><dd><a href="tel:<%= location.phone.replace(/\s/g, '') %>"><%= location.phone %></a></dd></div>
          </dl>
          <a class="text-link" href="mailto:<%= brandEmail %>?subject=<%= encodeURIComponent(`${location.city} appointment — Starfall Enigma`) %>"><%= t('stores.book') %> <span aria-hidden="true">↗</span></a>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="stores-partners">
    <div>
      <p class="eyebrow"><%= t('stores.partners') %></p>
      <h2><%= lang === 'id' ? 'Daftar mitra kami dijaga secara privat.' : 'Our partner list is kept private.' %></h2>
      <p><%= t('stores.partnerNote') %></p>
    </div>
    <a class="button button--outline" href="mailto:<%= brandEmail %>?subject=<%= encodeURIComponent('Concierge recommendation — Starfall Enigma') %>"><%= t('stores.contactCta') %> <span aria-hidden="true">↗</span></a>
  </section>

  <section class="stores-visit">
    <span class="stores-visit-star" aria-hidden="true">✦</span>
    <p class="eyebrow"><%= lang === 'id' ? 'Sebelum berkunjung' : 'Before your visit' %></p>
    <p><%= lang === 'id' ? 'Kami menerima satu atau dua tamu per slot. Beri tahu kami karya yang ingin Anda lihat, ukuran pakaian, atau waktu yang Anda butuhkan. Concierge akan mengonfirmasi ketersediaan melalui email.' : 'We receive one or two guests per slot. Tell us which pieces you would like to see, your clothing size, or the time you need. The concierge will confirm availability by email.' %></p>
  </section>
</main>
<%- include('partials/footer') %>
<%- include('partials/overlays') %>
<%- include('partials/scripts') %>
</body>
</html>
