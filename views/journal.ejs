<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content" class="journal-page">
  <header class="journal-hero">
    <p class="eyebrow"><%= t('journal.kicker') %> / SE</p>
    <h1><%= t('journal.title') %></h1>
    <p><%= t('journal.intro') %></p>
    <div class="journal-hero-meta">
      <span><%= lang === 'id' ? 'Esai & studi atelier' : 'Essays & atelier studies' %></span>
      <span><%= journal.length %> <%= lang === 'id' ? 'catatan' : 'notes' %></span>
      <span>2026</span>
    </div>
  </header>

  <% const [lead, ...rest] = journal; %>
  <% if (lead) { %>
  <article class="journal-lead">
    <a class="journal-lead-image" href="/journal/<%= lead.slug %>">
      <img src="<%= lead.image %>" alt="<%= lead.title %>" fetchpriority="high">
      <span class="journal-read"><%= t('journal.minRead', { count: lead.readMinutes }) %></span>
    </a>
    <div class="journal-lead-copy">
      <p class="eyebrow"><%= lead.category %> · <%= formatDate(lead.date) %></p>
      <h2><a href="/journal/<%= lead.slug %>"><%= lead.title %></a></h2>
      <p><%= lead.excerpt %></p>
      <a class="button button--outline" href="/journal/<%= lead.slug %>"><%= t('journal.read') %> <span aria-hidden="true">↗</span></a>
      <span class="journal-lead-number" aria-hidden="true">01</span>
    </div>
  </article>
  <% } %>

  <div class="journal-list">
    <% rest.forEach((article, index) => { %>
      <article class="journal-list-card" data-reveal style="--reveal-delay: <%= index * 80 %>ms">
        <a class="journal-list-image" href="/journal/<%= article.slug %>">
          <img src="<%= article.image %>" alt="<%= article.title %>" loading="lazy">
        </a>
        <div class="journal-list-copy">
          <p class="eyebrow"><%= article.category %> · <%= formatDate(article.date) %> · <%= t('journal.minRead', { count: article.readMinutes }) %></p>
          <h2><a href="/journal/<%= article.slug %>"><%= article.title %></a></h2>
          <p><%= article.excerpt %></p>
          <a class="text-link" href="/journal/<%= article.slug %>"><%= t('journal.read') %> <span aria-hidden="true">↗</span></a>
        </div>
        <span class="journal-list-number" aria-hidden="true">0<%= index + 2 %></span>
      </article>
    <% }) %>
  </div>

  <section class="journal-invite">
    <p class="eyebrow"><%= lang === 'id' ? 'Surat privat' : 'Private correspondence' %></p>
    <h2><%= lang === 'id' ? 'Catatan yang dikirim setelah gelap.' : 'Notes delivered after dark.' %></h2>
    <p><%= t('footer.newsletterText') %></p>
    <a class="button button--outline" href="#footer-newsletter-email"><%= t('footer.subscribe') %> <span aria-hidden="true">↗</span></a>
  </section>
</main>
<%- include('partials/footer') %>
<%- include('partials/overlays') %>
<%- include('partials/scripts') %>
</body>
</html>
