<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content" class="auth-page">
  <section class="auth-layout auth-layout--reverse">
    <div class="auth-image">
      <img src="/assets/img/editorial/model-01.jpg" alt="<%= lang === 'id' ? 'Model dalam jaket kulit gelap' : 'A model in a dark leather jacket' %>" fetchpriority="high">
      <div class="auth-image-overlay"></div>
      <div class="auth-image-copy">
        <span class="auth-image-mark" aria-hidden="true">SE</span>
        <p class="eyebrow"><%= lang === 'id' ? 'Lingkaran dalam' : 'The inner circle' %></p>
        <p><%= lang === 'id' ? 'Pesan privat, arsip tersimpan, dan akses awal ke setiap rilis.' : 'Private notes, a saved archive, and early access to each release.' %></p>
      </div>
    </div>
    <div class="auth-card-wrap">
      <div class="auth-card">
        <p class="eyebrow"><%= t('auth.register') %> / SE</p>
        <h1><%= t('auth.registerTitle') %></h1>
        <p class="auth-intro"><%= t('auth.registerIntro') %></p>
        <form class="auth-form" data-auth-form="register" data-next="<%= next %>" novalidate>
          <div class="form-grid">
            <div class="form-field">
              <label for="register-first"><%= t('common.firstName') %></label>
              <input id="register-first" name="firstName" type="text" autocomplete="given-name" required autofocus>
            </div>
            <div class="form-field">
              <label for="register-last"><%= t('common.lastName') %></label>
              <input id="register-last" name="lastName" type="text" autocomplete="family-name">
            </div>
          </div>
          <div class="form-field">
            <label for="register-email"><%= t('common.email') %></label>
            <input id="register-email" name="email" type="email" autocomplete="email" required>
          </div>
          <div class="form-grid">
            <div class="form-field">
              <label for="register-password"><%= t('common.password') %></label>
              <div class="password-field">
                <input id="register-password" name="password" type="password" autocomplete="new-password" minlength="8" required>
                <button type="button" data-password-toggle aria-label="<%= lang === 'id' ? 'Tampilkan kata sandi' : 'Show password' %>">◐</button>
              </div>
            </div>
            <div class="form-field">
              <label for="register-confirm"><%= t('auth.confirmPassword') %></label>
              <input id="register-confirm" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required>
            </div>
          </div>
          <label class="check-line auth-newsletter">
            <input type="checkbox" name="subscribe" checked>
            <span><%= t('auth.newsletter') %></span>
          </label>
          <div class="form-alert" data-auth-error hidden></div>
          <button class="button button--solid button--full" type="submit" data-auth-submit><%= t('auth.registerCta') %> <span aria-hidden="true">↗</span></button>
          <p class="auth-terms"><%= lang === 'id' ? 'Dengan membuat akun, Anda menyetujui' : 'By creating an account, you agree to our' %> <a href="/legal#terms"><%= t('footer.terms') %></a> <%= lang === 'id' ? 'dan' : 'and' %> <a href="/legal#privacy"><%= t('footer.privacy') %></a>.</p>
        </form>
        <div class="auth-switch">
          <p><%= t('auth.hasAccount') %> <a href="/login<%= next && next !== '/account' ? `?next=${encodeURIComponent(next)}` : '' %>"><%= t('auth.loginCta') %></a></p>
        </div>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
<%- include('partials/overlays') %>
<%- include('partials/scripts') %>
<script src="/js/auth.js" defer></script>
</body>
</html>
