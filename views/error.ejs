<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content" class="error-page">
  <div class="error-orbit" aria-hidden="true"><span>✦</span></div>
  <p class="eyebrow">SE / <%= status %></p>
  <h1><%= status === 404 ? (lang === 'id' ? 'Halaman ini telah menghilang.' : 'This page has vanished.') : (lang === 'id' ? 'Langit sedang gelap.' : 'The sky has gone dark.') %></h1>
  <p><%= message %></p>
  <div class="error-actions">
    <a class="button button--solid" href="/"><%= t('common.home') %> <span aria-hidden="true">↗</span></a>
    <a class="button button--outline" href="/shop"><%= t('nav.shopAll') %></a>
  </div>
  <span class="error-coordinates">STARFALL ENIGMA / SERVER</span>
</main>
<%- include('partials/footer') %>
<%- include('partials/overlays') %>
<%- include('partials/scripts') %>
</body>
</html>
