<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content" class="auth-page">
  <section class="auth-layout">
    <div class="auth-image">
      <img src="/assets/img/editorial/model-02.jpg" alt="<%= lang === 'id' ? 'Model dalam luaran kulit gelap' : 'A model in dark leather outerwear' %>" fetchpriority="high">
      <div class="auth-image-overlay"></div>
      <div class="auth-image-copy">
        <span class="auth-image-mark" aria-hidden="true">SE</span>
        <p class="eyebrow"><%= lang === 'id' ? 'Arsip privat' : 'The private archive' %></p>
        <p><%= lang === 'id' ? '“Yang Anda simpan mengatakan lebih banyak daripada yang Anda kenakan.”' : '“What you keep says more than what you wear.”' %></p>
      </div>
    </div>
    <div class="auth-card-wrap">
      <div class="auth-card">
        <p class="eyebrow"><%= t('auth.login') %> / SE</p>
        <h1><%= t('auth.loginTitle') %></h1>
        <p class="auth-intro"><%= t('auth.loginIntro') %></p>
        <form class="auth-form" data-auth-form="login" data-next="<%= next %>" novalidate>
          <div class="form-field">
            <label for="login-email"><%= t('common.email') %></label>
            <input id="login-email" name="email" type="email" autocomplete="email" required autofocus>
          </div>
          <div class="form-field">
            <label for="login-password"><%= t('common.password') %></label>
            <div class="password-field">
              <input id="login-password" name="password" type="password" autocomplete="current-password" required>
              <button type="button" data-password-toggle aria-label="<%= lang === 'id' ? 'Tampilkan kata sandi' : 'Show password' %>">◐</button>
            </div>
          </div>
          <div class="form-alert" data-auth-error hidden></div>
          <button class="button button--solid button--full" type="submit" data-auth-submit><%= t('auth.loginCta') %> <span aria-hidden="true">↗</span></button>
          <p class="auth-terms"><%= lang === 'id' ? 'Dengan masuk, Anda menyetujui penggunaan cookie sesi lokal.' : 'By signing in, you accept the use of a local session cookie.' %> <a href="/legal#cookies"><%= t('footer.cookies') %></a></p>
        </form>
        <div class="auth-switch">
          <p><%= t('auth.noAccount') %> <a href="/register<%= next && next !== '/account' ? `?next=${encodeURIComponent(next)}` : '' %>"><%= t('auth.registerCta') %></a></p>
        </div>
        <details class="auth-forgot">
          <summary><%= t('auth.forgot') %></summary>
          <p><%= t('auth.forgotNote') %> <a href="mailto:<%= brandEmail %>?subject=<%= encodeURIComponent('Password reset request — Starfall Enigma') %>"><%= brandEmail %></a></p>
        </details>
        <div class="auth-admin-link">
          <span><%= lang === 'id' ? 'Staf maison?' : 'Maison staff?' %></span>
          <a href="/admin/login"><%= t('auth.adminLogin') %> <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
<%- include('partials/overlays') %>
<%- include('partials/scripts') %>
<script src="/js/auth.js" defer></script>
</body>
</html>
