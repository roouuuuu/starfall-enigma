<div class="search-overlay" data-search-overlay aria-hidden="true">
  <div class="search-panel" role="dialog" aria-modal="true" aria-labelledby="search-title">
    <div class="search-panel-head">
      <p id="search-title" class="eyebrow"><%= t('search.title') %></p>
      <button type="button" class="icon-button search-close" data-search-close aria-label="<%= t('common.close') %>">×</button>
    </div>
    <form class="search-form" data-search-form role="search">
      <label class="sr-only" for="search-input"><%= t('search.title') %></label>
      <input id="search-input" type="search" name="q" autocomplete="off" placeholder="<%= t('search.placeholder') %>" data-search-input>
      <span class="search-submit-mark" aria-hidden="true">↵</span>
    </form>
    <div class="search-suggestions" data-search-suggestions>
      <div>
        <p class="eyebrow"><%= t('search.popular') %></p>
        <div class="search-chips">
          <a href="/shop/outerwear"><%= t('nav.outerwear') %></a>
          <a href="/shop?collection=nocturne">Nocturne</a>
          <a href="/shop/dresses"><%= t('nav.dresses') %></a>
          <a href="/shop/denim"><%= t('nav.denim') %></a>
        </div>
      </div>
      <div>
        <p class="eyebrow"><%= t('search.suggested') %></p>
        <div class="search-popular-links">
          <a href="/product/eclipsed-trench-coat"><span>Eclipsed Trench Coat</span><span aria-hidden="true">↗</span></a>
          <a href="/product/nocturne-leather-blouson"><span>Nocturne Leather Blouson</span><span aria-hidden="true">↗</span></a>
          <a href="/product/eclipse-bias-slip-dress"><span>Eclipse Bias Slip Dress</span><span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <div class="search-results" data-search-results></div>
    <a class="search-view-all" data-search-view-all href="/shop" hidden><%= t('search.viewAllResults') %> <span aria-hidden="true">↗</span></a>
  </div>
</div>

<div class="cart-backdrop" data-cart-backdrop></div>
<aside class="cart-drawer" data-cart-drawer aria-hidden="true" aria-labelledby="cart-title" role="dialog" aria-modal="true">
  <div class="cart-drawer-head">
    <div>
      <p class="eyebrow"><%= t('cart.title') %></p>
      <h2 id="cart-title"><%= t('common.bag') %> <span data-cart-drawer-count></span></h2>
    </div>
    <button type="button" class="icon-button" data-cart-close aria-label="<%= t('common.close') %>">×</button>
  </div>
  <div class="cart-drawer-body" data-cart-items></div>
  <div class="cart-drawer-foot">
    <div class="cart-subtotal-row">
      <span><%= t('common.subtotal') %></span>
      <strong data-cart-subtotal></strong>
    </div>
    <p class="cart-note"><%= t('cart.shippingNote') %></p>
    <a class="button button--solid button--full" href="/checkout" data-cart-checkout><%= t('cart.checkout') %> <span aria-hidden="true">↗</span></a>
    <button type="button" class="text-button" data-cart-close><%= t('cart.keepShopping') %></button>
  </div>
</aside>

<div class="toast-stack" data-toast-stack aria-live="polite" aria-atomic="false"></div>
<div class="cursor-note" aria-hidden="true">✦</div>
