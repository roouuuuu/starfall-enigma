<%
  const state = {
    lang,
    currency,
    exchangeRate,
    csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : '',
    user: user ? {
      id: user.id,
      firstName: user.firstName,
      lastName: user.lastName,
      email: user.email,
      role: user.role
    } : null,
    wishlistIds: Array.isArray(wishlistIds) ? wishlistIds : [],
    strings: clientStrings,
    page: typeof pageKey !== 'undefined' ? pageKey : '',
    orderPlaced: typeof placed !== 'undefined' && placed,
    routes: {
      shop: '/shop',
      checkout: '/checkout',
      wishlist: '/wishlist',
      account: '/account',
      login: '/login',
      register: '/register',
      cartResolve: '/api/cart/resolve'
    }
  };
  const canonicalPath = canonical || `${baseUrl}${currentPath}`;
  const previewImage = ogImage ? `${baseUrl}${ogImage}` : '';
%><!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle || 'STARFALL ENIGMA' %></title>
  <meta name="description" content="<%= metaDescription || '' %>">
  <meta name="theme-color" content="#0a0908">
  <meta name="color-scheme" content="dark">
  <% if (typeof noindex !== 'undefined' && noindex) { %>
  <meta name="robots" content="noindex, nofollow">
  <% } %>
  <link rel="canonical" href="<%= canonicalPath %>">
  <meta property="og:site_name" content="STARFALL ENIGMA">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:title" content="<%= pageTitle || 'STARFALL ENIGMA' %>">
  <meta property="og:description" content="<%= metaDescription || '' %>">
  <% if (previewImage) { %><meta property="og:image" content="<%= previewImage %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle || 'STARFALL ENIGMA' %>">
  <meta name="twitter:description" content="<%= metaDescription || '' %>">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/files/spooky-memories-regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/files/cormorant-garamond-normal-300700-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/files/jost-normal-300600-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('/assets/fonts/fonts.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/storefront.css') %>">
  <script nonce="<%= nonce %>">
    window.SE = <%- safeJson(state) %>;
  </script>
</head>
<body class="<%= bodyClass || '' %>" data-page="<%= typeof pageKey !== 'undefined' ? pageKey : '' %>" data-currency="<%= currency %>" data-lang="<%= lang %>" data-clear-cart="<%= typeof placed !== 'undefined' && placed ? '1' : '0' %>">
  <a class="skip-link" href="#main-content"><%= lang === 'id' ? 'Lewati ke konten' : 'Skip to content' %></a>
