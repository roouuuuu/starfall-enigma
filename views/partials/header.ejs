<%
  const navItems = [
    { id: 'new', href: '/shop?new=1', label: t('nav.newArrivals') },
    { id: 'clothing', href: '/shop', label: t('nav.clothing'), mega: true },
    { id: 'outerwear', href: '/shop/outerwear', label: t('nav.outerwear') },
    { id: 'denim', href: '/shop/denim', label: t('nav.denim') },
    { id: 'loungewear', href: '/shop/loungewear', label: t('nav.loungewear') },
    { id: 'journal', href: '/journal', label: t('nav.journal') },
    { id: 'about', href: '/about', label: t('nav.about') }
  ];
%>
<div class="announcement-bar">
  <div class="announcement-track" aria-hidden="true">
    <span><%= announcement || t('labels.complimentaryShipping') %></span>
    <span>✦</span>
    <span><%= t('labels.numberedEdition') %></span>
    <span>✦</span>
    <span><%= t('labels.freeReturns') %></span>
  </div>
  <p class="announcement-static"><%= announcement || t('labels.complimentaryShipping') %></p>
  <a href="/client-care" class="announcement-link"><%= t('nav.clientCare') %><span aria-hidden="true">↗</span></a>
</div>
<div class="utility-bar">
  <div class="utility-left">
    <span><%= lang === 'id' ? 'Arsip privat · Jakarta' : 'Private archive · Jakarta' %></span>
    <span class="utility-separator" aria-hidden="true"></span>
    <span>Collection 01 / <%= lang === 'id' ? 'Yang Tak Terucap' : 'The Unspoken' %></span>
  </div>
  <div class="utility-right">
    <% if (user && user.role === 'admin') { %><a href="/admin" class="utility-admin"><%= lang === 'id' ? 'Dashboard' : 'Dashboard' %> ↗</a><% } %>
    <a href="/stores"><%= t('nav.stores') %></a>
    <a href="/client-care"><%= t('nav.clientCare') %></a>
    <a href="<%= langSwitchUrl %>" hreflang="<%= lang === 'en' ? 'id' : 'en' %>" aria-label="<%= t('footer.selectLanguage') %>"><%= langAlt %></a>
    <a href="<%= currencySwitchUrl %>" aria-label="<%= t('footer.selectCurrency') %>"><%= currencyAlt %></a>
    <span class="utility-demo"><%= t('footer.demo') %></span>
  </div>
</div>
<header class="site-header" data-site-header>
  <div class="header-inner">
    <button class="icon-button header-menu-button" type="button" data-menu-toggle aria-label="<%= t('common.menu') %>" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
    <a class="brand" href="/" aria-label="Starfall Enigma — <%= t('common.home') %>">
      <img src="/assets/img/logo-mark.svg" width="30" height="30" alt="">
      <span class="brand-word">STARFALL ENIGMA</span>
    </a>
    <nav class="primary-nav" aria-label="<%= t('common.menu') %>">
      <% navItems.forEach((item) => { %>
        <div class="nav-item <%= item.mega ? 'has-mega' : '' %>">
          <a class="nav-link <%= activeNav === item.id ? 'is-active' : '' %>" href="<%= item.href %>" <%= item.mega ? 'aria-haspopup="true"' : '' %>><%= item.label %></a>
          <% if (item.mega) { %>
          <div class="mega-menu" role="group" aria-label="<%= t('nav.clothing') %>">
            <div class="mega-grid">
              <div class="mega-links">
                <p class="eyebrow"><%= t('nav.clothing') %></p>
                <a href="/shop"><span>01</span> <%= t('nav.shopAll') %></a>
                <% clothingCategories.forEach((category, index) => { %>
                  <a href="/shop/<%= category.id %>"><span>0<%= index + 2 %></span> <%= category.label %></a>
                <% }) %>
                <a class="mega-collections" href="/shop?collection=reliquary"><%= lang === 'id' ? 'Koleksi Reliquary' : 'The Reliquary collection' %> <span aria-hidden="true">↗</span></a>
              </div>
              <a class="mega-feature" href="/shop?category=tailoring,dresses">
                <img src="/assets/img/editorial/model-03.jpg" alt="<%= lang === 'id' ? 'Tailoring dan gaun Starfall Enigma' : 'Starfall Enigma tailoring and dresses' %>" loading="lazy">
                <span class="mega-feature-label"><%= lang === 'id' ? 'Tailoring dan gaun' : 'Tailoring & dresses' %><span aria-hidden="true">↗</span></span>
              </a>
            </div>
          </div>
          <% } %>
        </div>
      <% }) %>
    </nav>
    <div class="header-actions">
      <button class="icon-button" type="button" data-search-open aria-label="<%= t('search.open') %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M15.5 15.5 21 21" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
      </button>
      <% if (user) { %>
        <a class="icon-button account-button" href="<%= user.role === 'admin' ? '/admin' : '/account' %>" aria-label="<%= t('common.account') %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4.5 21c.5-4.2 3.3-6.5 7.5-6.5s7 2.3 7.5 6.5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
        </a>
      <% } else { %>
        <a class="icon-button account-button" href="/login?next=<%= encodeURIComponent(currentUrl) %>" aria-label="<%= t('common.account') %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4.5 21c.5-4.2 3.3-6.5 7.5-6.5s7 2.3 7.5 6.5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
        </a>
      <% } %>
      <a class="icon-button wishlist-header-link" href="/wishlist" aria-label="<%= t('common.wishlist') %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.2S4.2 15.4 4.2 9.4A4.2 4.2 0 0 1 12 6.6a4.2 4.2 0 0 1 7.8 2.8c0 6-7.8 10.8-7.8 10.8Z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
        <span class="count-badge" data-wishlist-count><%= wishlistIds.length || '' %></span>
      </a>
      <button class="icon-button bag-button" type="button" data-cart-open aria-label="<%= t('common.bag') %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 8.5h13l-1 12h-11l-1-12Z" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M9 9V6.8a3 3 0 0 1 6 0V9" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
        <span class="count-badge" data-cart-count></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true" role="dialog" aria-modal="true" aria-label="<%= t('common.menu') %>">
  <div class="mobile-menu-head">
    <span class="eyebrow"><%= t('common.menu') %></span>
    <button type="button" class="icon-button" data-menu-close aria-label="<%= t('common.close') %>">×</button>
  </div>
  <nav class="mobile-nav" aria-label="<%= t('common.menu') %>">
    <a href="/shop?new=1"><%= t('nav.newArrivals') %></a>
    <a href="/shop"><%= t('nav.shopAll') %></a>
    <details>
      <summary><%= t('nav.clothing') %></summary>
      <% clothingCategories.forEach((category) => { %>
        <a href="/shop/<%= category.id %>"><%= category.label %></a>
      <% }) %>
    </details>
    <a href="/journal"><%= t('nav.journal') %></a>
    <a href="/about"><%= t('nav.about') %></a>
    <a href="/stores"><%= t('nav.stores') %></a>
    <a href="/client-care"><%= t('nav.clientCare') %></a>
    <div class="mobile-menu-utility">
      <a href="<%= langSwitchUrl %>"><%= t('footer.selectLanguage') %> · <%= langAlt %></a>
      <a href="<%= currencySwitchUrl %>"><%= t('footer.selectCurrency') %> · <%= currencyAlt %></a>
      <% if (user) { %>
        <a href="<%= user.role === 'admin' ? '/admin' : '/account' %>"><%= t('common.account') %></a>
      <% } else { %>
        <a href="/login?next=<%= encodeURIComponent(currentUrl) %>"><%= t('auth.login') %></a>
      <% } %>
    </div>
  </nav>
</div>
<div class="page-shade" data-page-shade></div>
