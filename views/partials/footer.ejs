<footer class="site-footer">
  <section class="footer-newsletter" aria-labelledby="footer-newsletter-title">
    <div class="footer-newsletter-copy">
      <p class="eyebrow"><%= t('footer.newsletterTitle') %></p>
      <h2 id="footer-newsletter-title"><%= t('home.newsletterTitle') %></h2>
      <p><%= t('home.newsletterText') %></p>
    </div>
    <form class="newsletter-form" data-newsletter-form novalidate>
      <label class="sr-only" for="footer-newsletter-email"><%= t('home.newsletterPlaceholder') %></label>
      <input id="footer-newsletter-email" type="email" name="email" autocomplete="email" placeholder="<%= t('home.newsletterPlaceholder') %>" required>
      <button type="submit"><%= t('footer.subscribe') %><span aria-hidden="true">↗</span></button>
      <p class="form-note"><%= t('home.newsletterConsent') %></p>
      <p class="form-feedback" data-newsletter-feedback role="status"></p>
    </form>
  </section>

  <div class="footer-main">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="Starfall Enigma">
        <img src="/assets/img/logo-mark.svg" width="34" height="34" alt="">
        <span>STARFALL<br>ENIGMA</span>
      </a>
      <p><%= lang === 'id' ? 'Rumah bagi pakaian yang menyimpan bobot dan misterinya sendiri. Dipotong dalam jumlah kecil, diselesaikan dengan tangan.' : 'A house for clothes that keep their own weight and mystery. Cut in small runs, finished by hand.' %></p>
      <div class="footer-socials">
        <% if (socials.length) { %>
          <span><%= t('footer.follow') %></span>
          <% socials.forEach((social) => { %>
            <a href="<%= social.href %>" target="_blank" rel="noopener noreferrer"><%= social.label %><span aria-hidden="true">↗</span></a>
          <% }) %>
        <% } %>
      </div>
    </div>
    <div class="footer-columns">
      <div class="footer-column">
        <h3><%= t('common.bag') %> / <%= t('nav.shopAll') %></h3>
        <a href="/shop?new=1"><%= t('nav.newArrivals') %></a>
        <a href="/shop/outerwear"><%= t('nav.outerwear') %></a>
        <a href="/shop/tailoring"><%= t('nav.tailoring') %></a>
        <a href="/shop/knitwear"><%= t('nav.knitwear') %></a>
        <a href="/shop/dresses"><%= t('nav.dresses') %></a>
        <a href="/shop/denim"><%= t('nav.denim') %></a>
        <a href="/shop/loungewear"><%= t('nav.loungewear') %></a>
      </div>
      <div class="footer-column">
        <h3><%= t('footer.maison') %></h3>
        <a href="/about"><%= t('footer.about') %></a>
        <a href="/journal"><%= t('footer.journal') %></a>
        <a href="/stores"><%= t('footer.stores') %></a>
        <a href="/wishlist"><%= t('common.wishlist') %></a>
        <a href="/account"><%= t('common.account') %></a>
      </div>
      <div class="footer-column">
        <h3><%= t('footer.customerCare') %></h3>
        <a href="/client-care#faq"><%= t('footer.faq') %></a>
        <a href="/client-care#sizing"><%= t('footer.sizing') %></a>
        <a href="/client-care#shipping"><%= t('footer.shippingReturns') %></a>
        <a href="/client-care#care"><%= t('footer.careGuide') %></a>
        <a href="mailto:<%= brandEmail %>"><%= t('footer.contact') %></a>
      </div>
      <div class="footer-column">
        <h3><%= t('footer.legal') %></h3>
        <a href="/legal#privacy"><%= t('footer.privacy') %></a>
        <a href="/legal#terms"><%= t('footer.terms') %></a>
        <a href="/legal#cookies"><%= t('footer.cookies') %></a>
        <a href="/legal#accessibility"><%= t('footer.accessibility') %></a>
        <a href="/credits"><%= t('footer.credits') %></a>
      </div>
    </div>
  </div>

  <div class="footer-mark" aria-hidden="true">
    <span>STARFALL</span><span class="footer-mark-star">✦</span><span>ENIGMA</span>
  </div>

  <div class="footer-bottom">
    <p><%= t('footer.copyright', { year }) %></p>
    <p class="footer-demo"><%= t('footer.disclaimer') %></p>
    <div class="footer-bottom-links">
      <a href="<%= langSwitchUrl %>"><%= t('footer.selectLanguage') %> · <%= lang === 'id' ? 'Bahasa Indonesia' : 'English' %></a>
      <a href="<%= currencySwitchUrl %>"><%= t('footer.selectCurrency') %> · <%= currency %></a>
      <a href="/admin/login"><%= t('adminLink') %></a>
    </div>
  </div>
</footer>
