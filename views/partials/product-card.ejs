<%
  const cardData = {
    id: product.id,
    slug: product.slug,
    name: product.name,
    category: product.category,
    categoryLabel: product.categoryLabel,
    collection: product.collection,
    priceCents: product.priceCents,
    imageA: product.imageA,
    imageB: product.imageB,
    totalStock: product.totalStock,
    lowStock: product.lowStock,
    soldOut: product.soldOut,
    defaultVariant: product.defaultVariant ? {
      id: product.defaultVariant.id,
      label: product.defaultVariant.label,
      priceCents: product.defaultVariant.priceCents,
      stock: product.defaultVariant.stock
    } : null
  };
  const isSaved = Array.isArray(wishlistIds) && wishlistIds.includes(product.id);
%>
<article class="product-card" data-product-card data-product-id="<%= product.id %>" data-product-json="<%= JSON.stringify(cardData) %>">
  <div class="product-card-media">
    <a href="<%= product.url %>" class="product-image-wrap" aria-label="<%= product.name %>">
      <img class="product-image product-image--a" src="<%= product.imageA %>" alt="<%= product.name %>" loading="lazy" decoding="async">
      <img class="product-image product-image--b" src="<%= product.imageB %>" alt="" loading="lazy" decoding="async">
    </a>
    <% if (product.badgeLabel) { %>
      <span class="product-badge"><%= product.badgeLabel %></span>
    <% } else if (product.lowStock) { %>
      <span class="product-badge product-badge--quiet"><%= lang === 'id' ? 'Stok terbatas' : 'Low stock' %></span>
    <% } %>
    <button class="wishlist-toggle <%= isSaved ? 'is-saved' : '' %>" type="button" data-wishlist-toggle aria-label="<%= t('common.wishlist') %>" aria-pressed="<%= isSaved ? 'true' : 'false' %>">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.2S4.2 15.4 4.2 9.4A4.2 4.2 0 0 1 12 6.6a4.2 4.2 0 0 1 7.8 2.8c0 6-7.8 10.8-7.8 10.8Z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
    </button>
    <% if (!product.soldOut && product.defaultVariant) { %>
      <button class="quick-add" type="button" data-quick-add>
        <span><%= t('product.addToBag') %></span>
        <span aria-hidden="true">+</span>
      </button>
    <% } else { %>
      <span class="quick-add quick-add--disabled"><%= t('product.soldOut') %></span>
    <% } %>
  </div>
  <div class="product-card-info">
    <div>
      <p class="product-card-category"><%= product.categoryLabel %></p>
      <h3><a href="<%= product.url %>"><%= product.name %></a></h3>
    </div>
    <p class="product-card-price">
      <% if (product.hasPriceRange) { %><span><%= lang === 'id' ? 'Dari' : 'From' %></span><% } %>
      <span><%= money(product.priceCents) %></span>
    </p>
  </div>
</article>
