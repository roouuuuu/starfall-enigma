<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content">
  <section class="hero">
    <div class="hero-media">
      <img src="/assets/img/editorial/model-04.jpg" alt="<%= lang === 'id' ? 'Model dalam tailoring gelap di studio' : 'A model in dark tailoring in the studio' %>" fetchpriority="high">
      <div class="hero-veil"></div>
      <div class="hero-orbit" aria-hidden="true"><span></span></div>
    </div>
    <div class="hero-content">
      <p class="eyebrow"><%= t('home.heroKicker') %></p>
      <h1><%- t('home.heroTitle') %></h1>
      <p class="hero-text"><%= t('home.heroText') %></p>
      <div class="hero-actions">
        <a class="button button--solid" href="/shop"><%= t('home.exploreCollection') %> <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/about"><%= t('home.discoverMaison') %></a>
      </div>
      <div class="hero-meta">
        <span>01 / 04</span>
        <span><%= lang === 'id' ? 'Jakarta · 19:47' : 'Jakarta · 19:47' %></span>
        <span><%= lang === 'id' ? 'Edisi terbatas' : 'Limited release' %></span>
      </div>
    </div>
    <div class="hero-side-note" aria-hidden="true">
      <span>STARFALL</span><span>ENIGMA</span>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <% for (let i = 0; i < 2; i += 1) { t('home.ticker').forEach((line) => { %>
        <span><%= line %></span><span class="ticker-star">✦</span>
      <% }); } %>
    </div>
  </div>

  <section class="section arrivals-section" aria-labelledby="arrivals-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><%= t('home.newArrivals') %></p>
        <h2 id="arrivals-title"><%= t('home.newArrivalsText') %></h2>
      </div>
      <a class="text-link" href="/shop?new=1"><%= t('common.viewAll') %> <span aria-hidden="true">↗</span></a>
    </div>
    <div class="product-grid product-grid--four">
      <% newArrivals.forEach((product, index) => { %>
        <div data-reveal style="--reveal-delay: <%= index * 75 %>ms"><%- include('partials/product-card', { product }) %></div>
      <% }) %>
    </div>
  </section>

  <section class="collection-pair" aria-label="<%= t('home.featuredCollections') %>">
    <a class="collection-panel collection-panel--starfall" href="/shop?collection=starfall" data-reveal>
      <img src="/assets/img/editorial/model-03.jpg" alt="<%= lang === 'id' ? 'Tailoring gelap di studio' : 'Dark tailoring in the studio' %>" loading="lazy">
      <div class="collection-panel-overlay"></div>
      <div class="collection-panel-copy">
        <span class="eyebrow">01 / Collection</span>
        <h2>STARFALL</h2>
        <p><%= lang === 'id' ? 'Tailoring celestial dan sutra, dipotong untuk kegelapan.' : 'Celestial tailoring and silk, cut for the dark.' %></p>
        <span class="circle-link" aria-hidden="true">↗</span>
      </div>
    </a>
    <a class="collection-panel collection-panel--nocturne" href="/shop?collection=nocturne" data-reveal>
      <img src="/assets/img/editorial/model-02.jpg" alt="<%= lang === 'id' ? 'Luaran kulit gelap' : 'Dark leather outerwear' %>" loading="lazy">
      <div class="collection-panel-overlay"></div>
      <div class="collection-panel-copy">
        <span class="eyebrow">02 / Collection</span>
        <h2>NOCTURNE</h2>
        <p><%= lang === 'id' ? 'Denim menghitam, kulit, dan rajutan bercahaya bulan.' : 'Blackened denim, leather and moonlit knit.' %></p>
        <span class="circle-link" aria-hidden="true">↗</span>
      </div>
    </a>
  </section>

  <section class="section categories-section" aria-labelledby="categories-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><%= t('home.categoriesKicker') %></p>
        <h2 id="categories-title"><%= t('home.categoriesTitle') %></h2>
      </div>
      <p class="section-intro"><%= t('home.categoriesText') %></p>
    </div>
    <div class="category-grid">
      <% categoryTiles.forEach((category, index) => { %>
        <a class="category-tile <%= index === 0 ? 'category-tile--wide' : '' %>" href="/shop/<%= category.id %>" data-reveal style="--reveal-delay: <%= index * 55 %>ms">
          <img src="<%= category.image %>" alt="<%= category.label %>" loading="lazy">
          <span class="category-tile-index">0<%= index + 1 %></span>
          <span class="category-tile-label"><%= category.label %><span aria-hidden="true">↗</span></span>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="campaign-band">
    <img class="campaign-band-image" src="/assets/img/editorial/jacket.jpg" alt="<%= lang === 'id' ? 'Model dalam jaket kulit gelap' : 'Model in a dark leather jacket' %>" loading="lazy">
    <div class="campaign-band-overlay"></div>
    <div class="campaign-band-copy" data-reveal>
      <p class="eyebrow"><%= t('home.campaignKicker') %></p>
      <h2><%= t('home.campaignTitle') %></h2>
      <p><%= t('home.campaignText') %></p>
      <a class="button button--light" href="/shop/outerwear"><%= t('nav.outerwear') %> <span aria-hidden="true">↗</span></a>
    </div>
    <div class="campaign-band-credit"><%= lang === 'id' ? 'Studi editorial / Pexels' : 'Editorial study / Pexels' %></div>
  </section>

  <section class="section featured-row" aria-labelledby="featured-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><%= lang === 'id' ? 'Pilihan atelier' : 'Atelier selections' %></p>
        <h2 id="featured-title"><%= lang === 'id' ? 'Yang tetap tinggal setelah cahaya padam.' : 'What remains after the lights go down.' %></h2>
      </div>
      <a class="text-link" href="/shop"><%= t('common.viewAll') %> <span aria-hidden="true">↗</span></a>
    </div>
    <div class="product-grid product-grid--four">
      <% featured.forEach((product, index) => { %>
        <div data-reveal style="--reveal-delay: <%= index * 75 %>ms"><%- include('partials/product-card', { product }) %></div>
      <% }) %>
    </div>
  </section>

  <section class="story-section">
    <div class="story-image" data-reveal>
      <img src="/assets/img/editorial/model-05.jpg" alt="<%= lang === 'id' ? 'Model dalam gaun gelap' : 'A model in a dark dress' %>" loading="lazy">
      <span class="story-image-mark">SE</span>
    </div>
    <div class="story-copy" data-reveal>
      <p class="eyebrow"><%= t('home.storyKicker') %></p>
      <h2><%= t('home.storyTitle') %></h2>
      <p><%= t('home.storyText') %></p>
      <a class="text-link" href="/about"><%= t('home.storyCta') %> <span aria-hidden="true">↗</span></a>
      <div class="story-stats">
        <div><span>72</span><small><%= lang === 'id' ? 'Karya dalam arsip' : 'Pieces in the archive' %></small></div>
        <div><span>144</span><small><%= lang === 'id' ? 'Studi packshot orisinal' : 'Original packshot studies' %></small></div>
        <div><span>9</span><small><%= lang === 'id' ? 'Kategori pakaian' : 'Clothing categories' %></small></div>
      </div>
    </div>
  </section>

  <section class="section journal-section" aria-labelledby="journal-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><%= t('home.journalKicker') %></p>
        <h2 id="journal-title"><%= t('home.journalTitle') %></h2>
      </div>
      <a class="text-link" href="/journal"><%= t('common.viewAll') %> <span aria-hidden="true">↗</span></a>
    </div>
    <div class="journal-grid">
      <% journal.forEach((article, index) => { %>
        <article class="journal-card" data-reveal style="--reveal-delay: <%= index * 80 %>ms">
          <a class="journal-card-image" href="/journal/<%= article.slug %>">
            <img src="<%= article.image %>" alt="<%= article.title %>" loading="lazy">
            <span class="journal-read"><%= t('journal.minRead', { count: article.readMinutes }) %></span>
          </a>
          <div class="journal-card-copy">
            <p class="eyebrow"><%= article.category %> · <%= formatDate(article.date) %></p>
            <h3><a href="/journal/<%= article.slug %>"><%= article.title %></a></h3>
            <p><%= article.excerpt %></p>
            <a class="text-link" href="/journal/<%= article.slug %>"><%= t('journal.read') %> <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="stores-invite">
    <div class="stores-invite-image">
      <img src="/assets/img/editorial/cathedral.jpg" alt="<%= lang === 'id' ? 'Interior katedral gelap' : 'Dark cathedral interior' %>" loading="lazy">
    </div>
    <div class="stores-invite-copy" data-reveal>
      <p class="eyebrow"><%= t('home.storesKicker') %></p>
      <h2><%= t('home.storesTitle') %></h2>
      <p><%= t('home.storesText') %></p>
      <a class="button button--outline" href="/stores"><%= t('home.storesCta') %> <span aria-hidden="true">↗</span></a>
    </div>
    <div class="stores-invite-coordinates" aria-hidden="true">
      <span>6°13′ S</span><span>106°49′ E</span>
    </div>
  </section>

  <% if (socials.length) { %>
  <section class="social-invite">
    <p class="eyebrow"><%= t('home.socialKicker') %></p>
    <h2><%= t('home.socialTitle') %></h2>
    <div class="social-invite-links">
      <% socials.forEach((social) => { %>
        <a href="<%= social.href %>" target="_blank" rel="noopener noreferrer"><%= social.label %> <span aria-hidden="true">↗</span></a>
      <% }) %>
    </div>
  </section>
  <% } %>
</main>
<%- include('partials/footer') %>
<%- include('partials/overlays') %>
<%- include('partials/scripts') %>
</body>
</html>
