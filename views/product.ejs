<%
  const selectedVariant = product.defaultVariant || product.variants[0] || null;
  const productState = {
    id: product.id,
    slug: product.slug,
    name: product.name,
    category: product.category,
    categoryLabel: product.categoryLabel,
    collection: product.collection,
    priceCents: product.priceCents,
    imageA: product.imageA,
    imageB: product.imageB,
    totalStock: product.totalStock,
    soldOut: product.soldOut,
    variants: product.variants.map((variant) => ({
      id: variant.id,
      label: variant.label,
      priceCents: variant.priceCents,
      stock: variant.stock,
      available: variant.available,
      sku: variant.sku
    }))
  };
  const isSaved = Array.isArray(wishlistIds) && wishlistIds.includes(product.id);
%>
<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content" class="product-page">
  <nav class="product-breadcrumbs" aria-label="Breadcrumb">
    <a href="/"><%= t('common.home') %></a><span aria-hidden="true">/</span>
    <a href="/shop"><%= t('nav.shopAll') %></a><span aria-hidden="true">/</span>
    <a href="/shop/<%= product.category %>"><%= categoryLabel %></a><span aria-hidden="true">/</span>
    <span><%= product.name %></span>
  </nav>

  <section class="product-layout">
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery-main">
        <img src="<%= product.imageA %>" alt="<%= product.name %>" data-product-main-image fetchpriority="high">
        <button class="gallery-zoom" type="button" data-gallery-zoom aria-label="<%= lang === 'id' ? 'Perbesar gambar' : 'Enlarge image' %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M15.4 15.4 21 21M10.5 7.5v6M7.5 10.5h6" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
        </button>
        <% if (product.badgeLabel) { %><span class="product-detail-badge"><%= product.badgeLabel %></span><% } %>
      </div>
      <div class="product-gallery-thumbs" role="group" aria-label="<%= lang === 'id' ? 'Gambar produk' : 'Product images' %>">
        <button type="button" class="is-active" data-gallery-thumb data-src="<%= product.imageA %>" aria-label="<%= lang === 'id' ? 'Tampilan depan' : 'Front view' %>"><img src="<%= product.imageA %>" alt=""></button>
        <button type="button" data-gallery-thumb data-src="<%= product.imageB %>" aria-label="<%= lang === 'id' ? 'Tampilan detail' : 'Detail view' %>"><img src="<%= product.imageB %>" alt=""></button>
      </div>
      <p class="gallery-note"><%= lang === 'id' ? 'Studi vektor orisinal · Warna dapat berbeda pada layar' : 'Original vector study · Colour may vary on screen' %></p>
    </div>

    <div class="product-details">
      <div class="product-kicker">
        <p class="eyebrow"><%= product.categoryLabel %> / <%= product.collectionLabel %></p>
        <span class="product-ref"><%= t('product.sku') %> <%= product.sku %></span>
      </div>
      <h1><%= product.name %></h1>
      <div class="product-price-row">
        <p class="product-price" data-product-price>
          <% if (product.hasPriceRange) { %><span><%= lang === 'id' ? 'Dari' : 'From' %></span><% } %>
          <strong><%= money(product.priceCents) %></strong>
        </p>
        <span class="product-tax-note"><%= t('cart.subtotalNote') %></span>
      </div>
      <p class="product-description"><%= product.description %></p>

      <form class="product-buy-form" data-product-form data-product-json="<%= JSON.stringify(productState) %>" novalidate>
        <fieldset class="variant-fieldset">
          <legend>
            <span><%= lang === 'id' ? 'Pilih ukuran' : 'Select size' %></span>
            <a class="text-link text-link--small" href="/client-care#sizing"><%= t('product.sizeGuideLink') %></a>
          </legend>
          <div class="variant-options">
            <% product.variants.forEach((variant) => { %>
              <button type="button" class="variant-option <%= selectedVariant && selectedVariant.id === variant.id ? 'is-selected' : '' %>" data-variant-option data-variant-id="<%= variant.id %>" data-price-cents="<%= variant.priceCents %>" data-stock="<%= variant.stock %>" <%= variant.available ? '' : 'disabled' %> aria-pressed="<%= selectedVariant && selectedVariant.id === variant.id ? 'true' : 'false' %>">
                <span><%= variant.label %></span>
                <% if (!variant.available) { %><small><%= lang === 'id' ? 'Habis' : 'Sold out' %></small><% } else if (variant.stock <= variant.lowStockThreshold) { %><small><%= variant.stock %> <%= lang === 'id' ? 'tersisa' : 'left' %></small><% } %>
              </button>
            <% }) %>
          </div>
        </fieldset>

        <div class="product-stock-line" data-product-stock>
          <% if (product.soldOut) { %>
            <span class="stock-dot stock-dot--out"></span> <%= t('product.soldOut') %>
          <% } else if (selectedVariant && selectedVariant.stock <= selectedVariant.lowStockThreshold) { %>
            <span class="stock-dot stock-dot--low"></span> <%= t('product.lowStock', { count: selectedVariant.stock }) %>
          <% } else { %>
            <span class="stock-dot"></span> <%= lang === 'id' ? 'Tersedia untuk dikirim' : 'Available to ship' %>
          <% } %>
        </div>

        <div class="product-buy-row">
          <div class="quantity-field">
            <label for="product-quantity"><%= t('common.quantity') %></label>
            <div class="quantity-input">
              <button type="button" data-qty-minus aria-label="<%= lang === 'id' ? 'Kurangi jumlah' : 'Decrease quantity' %>">−</button>
              <input id="product-quantity" type="number" name="quantity" value="1" min="1" max="<%= Math.min(selectedVariant ? selectedVariant.stock : 0, 10) || 1 %>" inputmode="numeric">
              <button type="button" data-qty-plus aria-label="<%= lang === 'id' ? 'Tambah jumlah' : 'Increase quantity' %>">+</button>
            </div>
          </div>
          <button class="button button--solid product-add-button" type="submit" data-add-to-bag <%= product.soldOut ? 'disabled' : '' %>>
            <span data-add-label><%= t('product.addToBag') %></span><span aria-hidden="true">↗</span>
          </button>
          <button class="wishlist-toggle wishlist-toggle--detail <%= isSaved ? 'is-saved' : '' %>" type="button" data-wishlist-toggle data-product-id="<%= product.id %>" data-product-json="<%= JSON.stringify(productState) %>" aria-label="<%= t('common.wishlist') %>" aria-pressed="<%= isSaved ? 'true' : 'false' %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.2S4.2 15.4 4.2 9.4A4.2 4.2 0 0 1 12 6.6a4.2 4.2 0 0 1 7.8 2.8c0 6-7.8 10.8-7.8 10.8Z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
          </button>
        </div>
        <p class="product-form-feedback" data-product-feedback role="status"></p>
      </form>

      <div class="product-assurances">
        <div><span aria-hidden="true">✦</span><p><%= t('labels.complimentaryShipping') %></p></div>
        <div><span aria-hidden="true">↺</span><p><%= t('labels.freeReturns') %></p></div>
        <div><span aria-hidden="true">SE</span><p><%= t('labels.numberedEdition') %></p></div>
      </div>

      <div class="product-accordions">
        <details open>
          <summary><%= t('product.details') %><span aria-hidden="true">+</span></summary>
          <div class="accordion-body">
            <dl class="detail-list">
              <% product.details.forEach((detail) => { %>
                <div><dt><%= detail.label %></dt><dd><%= detail.value %></dd></div>
              <% }) %>
              <div><dt><%= lang === 'id' ? 'Dimensi kemasan' : 'Archive box' %></dt><dd><%= t('labels.packaging') %></dd></div>
            </dl>
          </div>
        </details>
        <details>
          <summary><%= t('product.care') %><span aria-hidden="true">+</span></summary>
          <div class="accordion-body"><p><%= product.care %></p></div>
        </details>
        <details id="shipping">
          <summary><%= t('product.shipping') %><span aria-hidden="true">+</span></summary>
          <div class="accordion-body"><p><%= t('product.shippingText') %></p></div>
        </details>
      </div>

      <div class="product-share">
        <span><%= t('product.share') %></span>
        <button type="button" class="text-button" data-share-copy><%= lang === 'id' ? 'Salin tautan' : 'Copy link' %></button>
        <span class="share-feedback" data-share-feedback></span>
      </div>
    </div>
  </section>

  <section class="product-category-note">
    <p class="eyebrow"><%= categoryLabel %></p>
    <p><%= categoryDescription %></p>
    <a class="text-link" href="/shop/<%= product.category %>"><%= t('common.viewAll') %> <span aria-hidden="true">↗</span></a>
  </section>

  <% if (related.length) { %>
  <section class="section related-section" aria-labelledby="related-title">
    <div class="section-head">
      <div>
        <p class="eyebrow"><%= t('product.related') %></p>
        <h2 id="related-title"><%= t('product.relatedText') %></h2>
      </div>
    </div>
    <div class="product-grid product-grid--four">
      <% related.forEach((item) => { %><%- include('partials/product-card', { product: item }) %><% }) %>
    </div>
  </section>
  <% } %>
</main>

<dialog class="image-dialog" data-image-dialog>
  <button type="button" class="icon-button image-dialog-close" data-image-dialog-close aria-label="<%= t('common.close') %>">×</button>
  <img src="<%= product.imageA %>" alt="<%= product.name %>" data-image-dialog-img>
</dialog>
<%- include('partials/footer') %>
<%- include('partials/overlays') %>
<%- include('partials/scripts') %>
<script src="<%= asset('/js/product.js') %>" defer></script>
</body>
</html>
