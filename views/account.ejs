<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content" class="account-page" data-account-page>
  <header class="account-hero">
    <div>
      <p class="eyebrow"><%= t('common.account') %> / SE</p>
      <h1><%= t('account.hello', { name: accountUser.first_name }) %></h1>
      <p><%= t('account.intro') %></p>
    </div>
    <div class="account-hero-meta">
      <span><%= accountUser.email %></span>
      <span><%= lang === 'id' ? 'Anggota sejak' : 'Member since' %> <%= formatDate(accountUser.created_at) %></span>
      <span class="account-id">SE / <%= String(accountUser.id).padStart(4, '0') %></span>
    </div>
  </header>

  <div class="account-layout">
    <aside class="account-nav" aria-label="<%= t('account.accountNavigation') %>">
      <button class="account-nav-item is-active" type="button" data-account-tab="profile"><span>01</span><%= t('account.profile') %></button>
      <button class="account-nav-item" type="button" data-account-tab="orders"><span>02</span><%= t('account.orders') %> <small><%= orders.length %></small></button>
      <button class="account-nav-item" type="button" data-account-tab="addresses"><span>03</span><%= t('account.addresses') %> <small><%= addresses.length %></small></button>
      <a class="account-nav-item" href="/wishlist"><span>04</span><%= t('common.wishlist') %> <small><%= wishlistCount %></small></a>
      <% if (accountUser.role === 'admin') { %><a class="account-nav-item account-nav-admin" href="/admin"><span>05</span>Dashboard <small>↗</small></a><% } %>
      <button class="account-nav-item account-nav-logout" type="button" data-logout><span>—</span><%= t('auth.logout') %></button>
    </aside>

    <div class="account-content">
      <section class="account-panel is-active" data-account-panel="profile">
        <div class="account-panel-head">
          <p class="eyebrow">01 / <%= t('account.profile') %></p>
          <h2><%= lang === 'id' ? 'Detail pribadi' : 'Personal details' %></h2>
        </div>
        <form class="account-form" data-profile-form novalidate>
          <div class="form-grid">
            <div class="form-field">
              <label for="account-first"><%= t('common.firstName') %></label>
              <input id="account-first" name="firstName" type="text" autocomplete="given-name" value="<%= accountUser.first_name %>" required>
            </div>
            <div class="form-field">
              <label for="account-last"><%= t('common.lastName') %></label>
              <input id="account-last" name="lastName" type="text" autocomplete="family-name" value="<%= accountUser.last_name %>">
            </div>
            <div class="form-field">
              <label for="account-email"><%= t('common.email') %></label>
              <input id="account-email" type="email" value="<%= accountUser.email %>" disabled>
              <small><%= lang === 'id' ? 'Hubungi concierge untuk mengubah email.' : 'Contact the concierge to change your email.' %></small>
            </div>
            <div class="form-field">
              <label for="account-phone"><%= t('common.phone') %></label>
              <input id="account-phone" name="phone" type="tel" autocomplete="tel" value="<%= accountUser.phone %>">
            </div>
          </div>
          <div class="form-alert" data-profile-feedback hidden></div>
          <button class="button button--solid" type="submit"><%= t('account.saveProfile') %> <span aria-hidden="true">↗</span></button>
        </form>

        <div class="account-rule"></div>

        <div class="account-panel-head account-panel-head--small">
          <p class="eyebrow">SE / <%= lang === 'id' ? 'Keamanan' : 'Security' %></p>
          <h2><%= t('account.changePassword') %></h2>
        </div>
        <form class="account-form" data-password-form novalidate>
          <div class="form-grid">
            <div class="form-field form-field--full">
              <label for="password-current"><%= t('account.currentPassword') %></label>
              <input id="password-current" name="currentPassword" type="password" autocomplete="current-password" required>
            </div>
            <div class="form-field">
              <label for="password-new"><%= t('account.newPassword') %></label>
              <input id="password-new" name="newPassword" type="password" autocomplete="new-password" minlength="8" required>
            </div>
            <div class="form-field">
              <label for="password-confirm"><%= lang === 'id' ? 'Konfirmasi kata sandi baru' : 'Confirm new password' %></label>
              <input id="password-confirm" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required>
            </div>
          </div>
          <div class="form-alert" data-password-feedback hidden></div>
          <button class="button button--outline" type="submit"><%= t('account.changePassword') %></button>
        </form>
      </section>

      <section class="account-panel" data-account-panel="orders">
        <div class="account-panel-head account-panel-head--row">
          <div><p class="eyebrow">02 / <%= t('account.orders') %></p><h2><%= lang === 'id' ? 'Riwayat pesanan' : 'Order history' %></h2></div>
          <a class="text-link" href="/shop"><%= t('common.continueShopping') %> <span aria-hidden="true">↗</span></a>
        </div>
        <% if (orders.length) { %>
          <div class="account-orders">
            <% orders.forEach((order) => { %>
              <article class="account-order">
                <div class="account-order-head">
                  <div><span><%= t('account.orderNumber') %></span><strong><%= order.order_number %></strong></div>
                  <div><span><%= t('account.date') %></span><strong><%= formatDate(order.created_at) %></strong></div>
                  <div><span><%= t('account.status') %></span><strong class="order-status order-status--<%= order.status %>"><%= statusLabel(order.status) %></strong></div>
                  <div><span><%= lang === 'id' ? 'Total' : 'Total' %></span><strong><%= money(order.total_usd_cents) %></strong></div>
                </div>
                <div class="account-order-foot">
                  <span><%= order.item_count %> <%= lang === 'id' ? 'baris karya' : 'piece lines' %></span>
                  <a class="text-link" href="/order/<%= encodeURIComponent(order.order_number) %>"><%= t('account.viewOrder') %> <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="account-empty">
            <span aria-hidden="true">✦</span>
            <h3><%= t('account.noOrders') %></h3>
            <p><%= t('account.noOrdersText') %></p>
            <a class="button button--outline" href="/shop"><%= t('cart.startShopping') %></a>
          </div>
        <% } %>
      </section>

      <section class="account-panel" data-account-panel="addresses">
        <div class="account-panel-head account-panel-head--row">
          <div><p class="eyebrow">03 / <%= t('account.addresses') %></p><h2><%= lang === 'id' ? 'Alamat pengiriman' : 'Delivery addresses' %></h2></div>
          <button class="button button--outline account-add-address" type="button" data-address-open><%= t('account.addAddress') %> <span aria-hidden="true">+</span></button>
        </div>
        <div class="address-list" data-address-list>
          <% if (addresses.length) { %>
            <% addresses.forEach((address) => { %>
              <article class="address-card" data-address-id="<%= address.id %>">
                <div class="address-card-head">
                  <span class="address-label"><%= address.label %></span>
                  <% if (address.is_default) { %><span class="address-default"><%= t('account.defaultAddress') %></span><% } %>
                </div>
                <p class="address-name"><%= address.first_name %> <%= address.last_name %></p>
                <address>
                  <span><%= address.address1 %></span>
                  <% if (address.address2) { %><span><%= address.address2 %></span><% } %>
                  <span><%= address.city %><%= address.region ? `, ${address.region}` : '' %> <%= address.postal_code %></span>
                  <span><%= address.country %></span>
                  <span><%= address.phone %></span>
                </address>
                <div class="address-actions">
                  <% if (!address.is_default) { %><button class="text-button" type="button" data-address-default="<%= address.id %>"><%= lang === 'id' ? 'Jadikan utama' : 'Make default' %></button><% } %>
                  <button class="text-button text-button--muted" type="button" data-address-delete="<%= address.id %>"><%= t('account.deleteAddress') %></button>
                </div>
              </article>
            <% }) %>
          <% } else { %>
            <div class="account-empty account-empty--compact">
              <span aria-hidden="true">✦</span>
              <h3><%= t('account.noAddresses') %></h3>
              <p><%= lang === 'id' ? 'Tambahkan alamat agar checkout berikutnya lebih cepat.' : 'Add an address to speed up your next checkout.' %></p>
            </div>
          <% } %>
        </div>
        <div class="form-alert" data-address-feedback hidden></div>
      </section>
    </div>
  </div>
</main>

<dialog class="form-dialog" id="address-dialog" data-address-dialog>
  <form class="form-dialog-inner" data-address-form novalidate>
    <div class="form-dialog-head">
      <div><p class="eyebrow"><%= t('account.addresses') %> / SE</p><h2><%= t('account.addAddress') %></h2></div>
      <button class="icon-button" type="button" data-address-close aria-label="<%= t('common.close') %>">×</button>
    </div>
    <div class="form-grid">
      <div class="form-field">
        <label for="address-label"><%= lang === 'id' ? 'Label' : 'Label' %></label>
        <input id="address-label" name="label" type="text" value="Rumah" maxlength="40">
      </div>
      <div class="form-field">
        <label for="address-country"><%= t('common.country') %></label>
        <input id="address-country" name="country" type="text" value="Indonesia" autocomplete="country-name">
      </div>
      <div class="form-field">
        <label for="address-first"><%= t('common.firstName') %></label>
        <input id="address-first" name="firstName" type="text" value="<%= accountUser.first_name %>" autocomplete="given-name" required>
      </div>
      <div class="form-field">
        <label for="address-last"><%= t('common.lastName') %></label>
        <input id="address-last" name="lastName" type="text" value="<%= accountUser.last_name %>" autocomplete="family-name">
      </div>
      <div class="form-field form-field--full">
        <label for="address-line1"><%= t('common.address') %></label>
        <input id="address-line1" name="address1" type="text" autocomplete="address-line1" required>
      </div>
      <div class="form-field form-field--full">
        <label for="address-line2"><%= t('common.address2') %> <em><%= t('common.optional') %></em></label>
        <input id="address-line2" name="address2" type="text" autocomplete="address-line2">
      </div>
      <div class="form-field">
        <label for="address-city"><%= t('common.city') %></label>
        <input id="address-city" name="city" type="text" autocomplete="address-level2" required>
      </div>
      <div class="form-field">
        <label for="address-region"><%= t('common.region') %></label>
        <input id="address-region" name="region" type="text" autocomplete="address-level1">
      </div>
      <div class="form-field">
        <label for="address-postal"><%= t('common.postalCode') %></label>
        <input id="address-postal" name="postalCode" type="text" autocomplete="postal-code" required>
      </div>
      <div class="form-field">
        <label for="address-phone"><%= t('common.phone') %></label>
        <input id="address-phone" name="phone" type="tel" value="<%= accountUser.phone %>" autocomplete="tel">
      </div>
      <label class="check-line form-field--full">
        <input type="checkbox" name="isDefault">
        <span><%= lang === 'id' ? 'Jadikan alamat utama' : 'Set as default address' %></span>
      </label>
    </div>
    <div class="form-alert" data-address-dialog-error hidden></div>
    <div class="form-dialog-actions">
      <button class="text-button" type="button" data-address-close><%= t('common.cancel') %></button>
      <button class="button button--solid" type="submit"><%= t('common.save') %> <span aria-hidden="true">↗</span></button>
    </div>
  </form>
</dialog>

<%- include('partials/footer') %>
<%- include('partials/overlays') %>
<%- include('partials/scripts') %>
<script src="/js/account.js" defer></script>
</body>
</html>
