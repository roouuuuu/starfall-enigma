<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="admin-base" content="<%= adminBase %>">
  <title><%= pageTitle %></title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#0b0a09">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/files/cormorant-garamond-normal-300700-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/files/jost-normal-300600-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('/assets/fonts/fonts.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/admin.css') %>">
  <script nonce="<%= nonce %>">
    window.SE = {
      csrfToken: <%- safeJson(csrfToken || '') %>,
      page: <%- safeJson(typeof pageKey !== 'undefined' ? pageKey : '') %>,
      lang: 'id'
    };
  </script>
</head>
<body class="<%= bodyClass || 'admin-auth-body' %>">
